<%- include('header') %>            
    
    <h1>Catatan Saya</h1>
        

            <% dataCatatan.forEach(item => { %>
            <div class="card">
                <small style="color: #666;"><%= item.waktu %></small>
                <p style="font-size: 1.1em; margin: 10px 0;"><%= item.isi %></p>
                <div style="display: flex; gap: 15px;">
                    <a href="/edit/<%= item.id %>">Edit</a>
                    <a href="/hapus/<%= item.id %>" class="btn-hapus" onclick="return confirm('Yakin mau dihapus?')">Hapus</a>
                </div>
            </div>
           <% }) %>

           <a href="/tambah" class="btn-tambah" style="display: block; text-align: center; background: #007bff; color: white; padding: 15px; border-radius: 5px; text-decoration: none; margin-top: 20px;">+ Tambah Baru</a>

           <hr style="margin: 20px 0; border: 0; border-top: 1px solid #eee;">
           <a href="profil" style="display: block; text-align: center; color: #666; font-size: 0.8em; text-decoration: none;">Tentang Pembuat</a>
        <%- include('footer') %>