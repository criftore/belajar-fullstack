<%- include('header') %>
        <h1>Tambah Catatan Baru</h1>
        <form action="/catatan/simpan" method="POST">
            <textarea name="catatan_baru" rows="4" cols="59" placeholder="Ketik catatanmu di sini..." required oninvalid="this.setCustomValidity('Waduh, catatannya jangan dikosongin ya!')"
    oninput="this.setCustomValidity('')"></textarea>
            <br>
            <button type="submit">Simpan Catatan</button>
            <a href="/catatan/baca" class="btn-batal">Batal</a>
        </form>
    <%- include('footer') %>