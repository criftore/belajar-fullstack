<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aplikasi Catatan</title>
    <style>
      body {
        font-family: sans-serif;
        background: #f4f4f9;
        padding: 20px;
        margin: 0;
      }
      .container {
        max-width: 600px;
        margin: 20px auto;
        background: white;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      }
      nav{
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 1px solid #eee;
      }
      nav a {
        text-decoration: none;
        color: #007bff;
        margin-right: 15px;
        font-weight: bold;
      }

      .search-box {
        margin-top: 10px;
        display: flex;
        gap: 5px;
      }
      .search-box input {
        flex: 1;
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 5px;
      }

      .card {
        border-left: 5px solid #007bff;
        background: #f9f9f9;
        padding: 15px;
        margin-bottom: 15px;
        border-radius: 10px;
      }
      textarea {
        width: 100%;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-size: 16px;
        box-sizing: border-box;
      }
      button {
        background: #007bff;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        margin-top: 10px;
      }
      button:hover {
        background: #0056b3;
      }

      .btn-hapus {
        color: #dc3545;
        text-decoration: none;
      }
      .btn-batal {
        color: #666;
        text-decoration: none;
        margin-left: 10px;
        font-size: 0.9em;
      }

      @media screen and (max-width:600px) {
        body {
          padding: 10px;
        }
        .container {
          width: 95%;
          padding: 15px;
          margin: 10px auto;
        }
        h1 {
          font-size: 1.5em;
        }
        textarea {
          font-size: 14px;
        }
        button {
          width: 100%;
          padding: 15px;
        }
        .btn-batal {
          display: block;
          text-align: center;
          margin-top: 15px;
          margin-left: 0;
        }
        
      } 
        
      
    </style>
  </head>
  <body>
    <div class="container">
      <nav>
        <a href="/baca-catatan">Home</a>
        <a href="/tambah">Tambah Catatan</a>
        <a href="/profil">Profil</a>

        <form action="/cari" method="GET" class="search-box">
          <input type="text" name="keyword" placeholder="Cari sesuatu..." required>
          <button type="submit" style="width: auto; padding: 8px 15px;">🔍</button>
        </form>
      </nav>
      </nav>
