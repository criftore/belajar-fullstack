<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aplikasi Catatan</title>
  <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <div class="container">
      <nav>
        <% if (isLoggedIn) { %>
        <a href="/catatan/baca">Home</a>
        <a href="/catatan/tambah">Tambah Catatan</a>
        <a href="/catatan/profil">Profil</a>
        <a href="/logout" style="color: #dc3545; margin-left: 20px;">Log out</a>

        <form action="/catatan/cari" method="GET" class="search-box">
          <input type="text" name="keyword" placeholder="Cari sesuatu..." required>
          <button type="submit" style="width: auto; padding: 8px 15px;">🔍</button>
        </form>
        <% } else { %>
          <span style="font-weight: bold;">Silahkan Login</span>
          <% } %>
      </nav>
      
