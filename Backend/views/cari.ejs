<%- include('header') %>

            <h1>Hasil Pencarian</h1>
            <p>Kata kunci: "<strong><%= keyword %></strong>"</p>
            <p>Ditemukan <%=hasil.length %> catatan.</p>
            <hr style="border: 0; border-top: 1px solid #eee; margin: 15px 0;">

            <% if (hasil.length === 0) { %>
            <p>Tidak ada catatan yang cocok.</p>
        <% } else { %>
        <% hasil.forEach(item => { %>
        <div class="card" style="border-left-color: #28a745;">
            <small style="color: #666"><%= item.waktu %></small>
            <p><%= item.isi %></p>
            <a href="/edit/<%= item.id %>" style="margin-right: 15px;">Edit</a>
            <a href="/hapus/<%= item.id %>" class="btn-hapus" onclick="return confirm('Yakin mau dihapus?')">Hapus</a>
        </div>
        <% }) %>
        <% } %>

        <a href="/baca-catatan" class="btn-kembali" style="display: block; text-align: center; margin-top: 20px; color: #007bff; text-decoration: none;"> <= Kembali ke Catatan</a>